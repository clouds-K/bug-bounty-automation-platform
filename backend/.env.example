# Copy this file to backend/.env and fill in YOUR OWN values.
# Never commit the real .env file.

# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=True

# --- Security (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- NVD API (free key: https://nvd.nist.gov/developers/request-an-api-key) ---
NVD_API_KEY=your-nvd-api-key

# --- Stripe (use TEST keys only) ---
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/bugbounty

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
